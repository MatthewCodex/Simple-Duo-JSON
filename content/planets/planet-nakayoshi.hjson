# The planet's display name. If you want to support multiple languages, use bundles instead!
localizedName: Planet Nakayoshi

# The mesh of the planet. At least MultiMesh is supported, so you can put multiple
# NoiseMesh'es to your planet!
mesh: {
  # Mesh type. Self-explanatory.
  type: NoiseMesh
  # A number used for mesh generation.
  seed: 69
  # Mesh "quality". More divisions = more hexagons.
  divisions: 4
  # First color to be used.
  color1: a2a2c2
  # Second color to be used.
  color2: 22262b
  # Mesh radius.
  radius: 1
  # A noise property.
  octaves: 3
  # A noise property.
  persistence: 0.8
  # Noise scale.
  scale: 1
  # A noise property.
  mag: 1.5
}

# The mesh used for clouds. (Now supported btw)
cloudMesh: {
  # A class name.
  type: HexSkyMesh
  # A number used for cloud generation.
  seed: 96
  # Cloud move speed.
  speed: 0.4
  # Cloud sphere radius.
  radius: 0.05
  # Clouds "quality". More divisions = more hexagons.
  divisions: 4
  # Cloud color.
  color: 4662e87e
  # A noise property.
  octaves: 3
  # A noise property.
  persistence: 0.7
  # Noise scale.
  scl: 1
  # Maximum number threshold for the noise.
  thresh: 0.4
}

# A planet generator. For (H)JSON planets it's pre-determined (AsteroidGenerator) and cannot be changed.
# But you can at least modify the existing one's fields. Highly not recommended unless you REALLY know what you're doing,
# better make sector presets and don't waste your time with this.
generator: {
  # Mininum amount of asteroids.
  min: 1
  # Maximum amount of asteroids.
  max: 1

  # Noise properties.
  octaves: 2
  persistence: 0.4
  scale: 30
  mag: 0.4
  thresh: 1
  foct: 3
  fmag: 0.5
  fscl: 50
  fper: 0.6

  # Asteroid radius range.
  radMin: 600
  radMax: 600

  # This one is ABSOLUTELY pointless, lmao.
  stoneChance: 0

  # Terrain generation chances, in order: ice > carbon > beryl > ferric.
  iceChance: 0.5
  carbonChance: 1
  berylChance: 0
  ferricChance: 0
}
allowCampaignRules: true
allowLaunchLoadout: false
allowLaunchSchematics: false
allowLaunchToNumbered: false
allowLegacyLaunchPads: false
allowSectorInvasion: false
allowSelfSectorLaunch: false
allowWaveSimulation: false

iconColor: 98c1f5
landCloudColor: e2effc60
hasAtmosphere: true
bloom: false

fog: true
showSpawns: true
campaignRuleDefaults.fog: true
campaignRuleDefaults.showSpawns: true

startSector: 0
sectorSize: 3
parent: sun
solarSystem: sun
tidalLock: true
orbitRadius: 80
orbitTime: 3000
orbitSpacing: 1
radius: 1.2

prebuildBase: true
clearSectorOnLose: true
coreDestroyClear: true
onlyDepositCore: true
defaultCore: 11k-01-core-apex
enemyBuildSpeedMultiplier: 0.2
enemyCoreSpawnReplace: false
updateLighting: false

launchCandidates: []
