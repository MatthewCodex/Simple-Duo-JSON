      // Octaves, quality, and scale control the noise patterns
      octaves: 3
      persistence: 0.5
      scale: 0.8
      mag: 0.5
    }
    // Layer 2: Shallow Water & Sand (Generates just above ocean level)
    {
      type: NoiseMesh
      planet: your-planet-name
      seed: 1204
      divisions: 5
      radius: 1
      color1: e5c890
      color2: d1b170
      octaves: 4
