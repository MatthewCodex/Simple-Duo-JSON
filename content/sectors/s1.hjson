# content/sectors/mysector.hjson
name: s1
displayName: Whispering Ridges
description: A procedurally generated base sector with high enemy threat.

# Map this sector directly to your planet and tile ID
planet: planet-nakayoshi
sector: 15

# Difficulty and base rules configuration
difficulty: 6
alwaysUnlocked: true
captureWave: 30

# Override starting parameters for procedural layouts
addStartingItems: true
allowLaunchSchematics: true

# Procedural wave configuration rules
rules: {
  attackMode: false
  winWave: 30
  enemyCoreBuildRadius: 150
  
  # Base wave compositions for procedural defense
  spawns: [
    {
      type: dagger
      wave: 1
      amount: 2
    }
    {
      type: crawler
      wave: 5
      amount: 4
    }
  ]
}
