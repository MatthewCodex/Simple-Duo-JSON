name: sector-frontline
planet: planet-nakayoshi
sector: 24  // The assigned hex position on the planet grid

# Crucial configuration for procedural enemy base maps:
captureWave: 0  // Setting this to 0 removes wave survival requirements
rules: {
  attackMode: true // Forces the map into Attack Mode instead of Survival
  enemyCoreBuildRadius: 150 // Distance buffering around the enemy base
}

# The visual and procedural threat parameters
difficulty: 6
