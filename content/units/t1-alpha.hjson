type: flying
name: Delta
description: A custom core flying unit that builds and mines efficiently.
lowAltitude: true

# Core Unit settings
isCounted: false
controller: BuilderAI
coreUnitDock: true

# Base Attributes
health: 220
armor: 1
speed: 4.5
