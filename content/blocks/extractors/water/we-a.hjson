type: SolidPump
name: T1 Rotary Water Extractor
description: Extracts groundwater using a heavy rotating turbine.
size: 2
health: 360
hasPower: true
category: production
liquidCapacity: 25
hasLiquids: true

// Liquid production settings
result: water
pumpAmount: 0.25

// Requirements to build
requirements: [
  copper/25
  lead/25
  metaglass/50
]

// Power consumption
consumes: {
  power: 1
}

// Visuals and Rotation
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawDefault
    }
    {
      type: DrawRotator
      suffix: -rotator
      // Speed of rotation. Higher is faster. Negative values reverse direction.
      rotateSpeed: 2
    }
    {
      type: DrawRegion
      suffix: -top
    }
  ]
}

research: mechanical-pump
