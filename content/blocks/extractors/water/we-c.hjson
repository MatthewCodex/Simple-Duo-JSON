type: SolidPump
name: Rotary Water Extractor
description: Extracts groundwater using a heavy rotating turbine.
size: 2
health: 600
hasPower: true
category: production
liquidCapacity: 75
hasLiquids: true

// Liquid production settings
result: water
pumpAmount: 0.75

// Requirements to build
requirements: [
  copper/75
  lead/75
  metaglass/150
]

// Power consumption
consumes: {
  power: 3
}

// Visuals and Rotation
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawDefault
    }
    {
      type: DrawRotator
      suffix: -rotator
      // Speed of rotation. Higher is faster. Negative values reverse direction.
      rotateSpeed: 4
    }
    {
      type: DrawRegion
      suffix: -top
    }
  ]
}

research: we-b
