type: SolidPump
name: Rotary Water Extractor
description: Extracts groundwater using a heavy rotating turbine.
size: 2
health: 480
hasPower: true
category: production
liquidCapacity: 50
hasLiquids: true

// Liquid production settings
result: water
pumpAmount: 0.5

// Requirements to build
requirements: [
  copper/50
  lead/50
  metaglass/100
]

// Power consumption
consumes: {
  power: 2
}

// Visuals and Rotation
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawDefault
    }
    {
      type: DrawRotator
      suffix: -rotator
      // Speed of rotation. Higher is faster. Negative values reverse direction.
      rotateSpeed: 3
    }
    {
      type: DrawRegion
      suffix: -top
    }
  ]
}

research: we-a
