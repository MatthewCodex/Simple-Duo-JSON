type: SolidPump
name: Rotary Water Extractor
description: Extracts groundwater using a heavy rotating turbine.
size: 2
health: 720
hasPower: true
category: production
liquidCapacity: 100
hasLiquids: true

// Liquid production settings
result: water
pumpAmount: 1

// Requirements to build
requirements: [
  copper/100
  lead/100
  metaglass/200
]

// Power consumption
consumes: {
  power: 4
}

// Visuals and Rotation
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawDefault
    }
    {
      type: DrawRotator
      suffix: -rotator
      // Speed of rotation. Higher is faster. Negative values reverse direction.
      rotateSpeed: 5
    }
    {
      type: DrawRegion
      suffix: -top
    }
  ]
}

research: we-c
