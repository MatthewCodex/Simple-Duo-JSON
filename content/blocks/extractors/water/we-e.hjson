type: SolidPump
name: Rotary Water Extractor
description: Extracts groundwater using a heavy rotating turbine.
size: 2
health: 840
hasPower: true
category: production
liquidCapacity: 200
hasLiquids: true

// Liquid production settings
result: water
pumpAmount: 2

// Requirements to build
requirements: [
  copper/200
  lead/200
  metaglass/400
]

// Power consumption
consumes: {
  power: 5
}

// Visuals and Rotation
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawDefault
    }
    {
      type: DrawRotator
      suffix: -rotator
      // Speed of rotation. Higher is faster. Negative values reverse direction.
      rotateSpeed: 6
    }
    {
      type: DrawRegion
      suffix: -top
    }
  ]
}

research: we-d
