type: SolidPump
name: T3 Rotary Oil Extractor
description: Extracts oil. Requires power.
size: 3
health: 800
hasPower: true
category: production
liquidCapacity: 50
hasLiquids: true

// Liquid production settings
result: oil
pumpAmount: 1.0

// Requirements to build
requirements: [
  titanium/100
  lead/100
  metaglass/100
]

// Power consumption
consumes: {
  power: 3.0
}

// Visuals and Rotation
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawDefault
    }
    {
      type: DrawRotator
      suffix: -rotator
      // Speed of rotation. Higher is faster. Negative values reverse direction.
      rotateSpeed: 2
    }
    {
      type: DrawRegion
      suffix: -top
    }
  ]
}

research: oe-b

conductivePower: true

shownPlanets: [serpulo , erekir , rospuleball]
