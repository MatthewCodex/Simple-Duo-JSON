type: GenericCrafter
name: T3 Kiln
description: Turns sand and lead into metaglass. Glows when active.
size: 2
hasItems: true
craftTime: 30

# Base light settings for the block
emitLight: true
lightRadius: 60

consumes: {
  items: [
    coal/1
    sand/1
  ]
}

requirements: [
metaglass/75
copper/75
lead/75
]

outputItem: metaglass/4

# This section controls the visual glow during crafting
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawDefault
    }
    {
      type: DrawFlame
      flameColor: ffef99ff
    }
  ]
}

category: crafting
research: k-b