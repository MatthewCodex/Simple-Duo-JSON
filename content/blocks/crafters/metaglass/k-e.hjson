type: GenericCrafter
name: T5 Kiln
description: Turns sand and lead into metaglass. Glows when active.
size: 2
hasItems: true
craftTime: 10

# Base light settings for the block
emitLight: true
lightRadius: 60

consumes: {
  items: [
    coal/1
    sand/1
  ]
}

requirements: [
metaglass/200
copper/200
lead/200
]

outputItem: metaglass/6

# This section controls the visual glow during crafting
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawDefault
    }
    {
      type: DrawFlame
      flameColor: ffef99ff
    }
  ]
}

category: crafting
research: k-d