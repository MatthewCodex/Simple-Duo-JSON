type: GenericCrafter
name: T2 Kiln
description: Turns sand and lead into metaglass. Glows when active.
size: 2
hasItems: true
craftTime: 45

# Base light settings for the block
emitLight: true
lightRadius: 60

consumes: {
  items: [
    coal/1
    sand/1
  ]
}

requirements: [
metaglass/50
copper/50
lead/50
]

outputItem: metaglass/3

# This section controls the visual glow during crafting
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawDefault
    }
    {
      type: DrawFlame
      flameColor: ffef99ff
    }
  ]
}

category: crafting
research: kiln