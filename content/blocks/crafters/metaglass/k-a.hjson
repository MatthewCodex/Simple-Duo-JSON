type: GenericCrafter
name: T1 Kiln
description: Turns sand and lead into metaglass. Glows when active.
size: 2
hasItems: true
craftTime: 60

# Base light settings for the block
emitLight: true
lightRadius: 60

consumes: {
  items: [
    lead/1
    sand/1
  ]
}

requirements: [
metaglass/25
copper/25
lead/25
]

outputItem: metaglass/2

# This section controls the visual glow during crafting
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawDefault
    }
    {
      type: DrawFlame
      flameColor: ffef99ff
    }
  ]
}

category: crafting
research: kiln