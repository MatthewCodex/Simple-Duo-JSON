type: GenericCrafter
name: T5 Surge Smelter
description: Turns copper, lead, titanium, and silicon into surge alloy. Requires power. Glows when active.
size: 3
hasPower: true
hasItems: true
craftTime: 10

# Base light settings for the block
emitLight: true
lightRadius: 60

consumes: {
  power: 6.0
  items: [
    copper/1
    lead/1
    titanium/1
    silicon/1
  ]
}

requirements: [
silicon/300
lead/300
thorium/300
]

outputItem: surge-alloy/6

# This section controls the visual glow during crafting
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawDefault
    }
    {
      type: DrawFlame
      flameColor: ffef99ff
    }
  ]
}

category: crafting
research: susm-d
conductivePower: true

shownPlanets: [serpulo , erekir , rospuleball]