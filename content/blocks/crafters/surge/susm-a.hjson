type: GenericCrafter
name: T1 Surge Smelter
description: Turns copper, lead, titanium, and silicon into surge alloy. Requires power. Glows when active.
size: 3
hasPower: true
hasItems: true
craftTime: 60

# Base light settings for the block
emitLight: true
lightRadius: 60

consumes: {
  power: 2.0
  items: [
    copper/1
    lead/1
    titanium/1
    silicon/1
  ]
}

requirements: [
silicon/25
lead/25
thorium/25
]

outputItem: surge-alloy/2

# This section controls the visual glow during crafting
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawDefault
    }
    {
      type: DrawFlame
      flameColor: ffef99ff
    }
  ]
}

category: crafting
research: surge-smelter
conductivePower: true

shownPlanets: [serpulo , erekir , rospuleball]