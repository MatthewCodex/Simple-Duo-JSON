type: GenericCrafter
name: T3 Surge Smelter
description: Turns copper, lead, titanium, and silicon into surge alloy. Requires power. Glows when active.
size: 3
hasPower: true
hasItems: true
craftTime: 30

# Base light settings for the block
emitLight: true
lightRadius: 60

consumes: {
  power: 4.0
  items: [
    copper/1
    lead/1
    titanium/1
    silicon/1
  ]
}

requirements: [
silicon/100
lead/100
thorium/100
]

outputItem: surge-alloy/4

# This section controls the visual glow during crafting
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawDefault
    }
    {
      type: DrawFlame
      flameColor: ffef99ff
    }
  ]
}

category: crafting
research: susm-b
conductivePower: true

shownPlanets: [serpulo , erekir , rospuleball]