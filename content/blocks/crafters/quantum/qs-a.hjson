type: GenericCrafter
name: T1 Quantum Smelter
description: Turns Thorium, Phase Fabric, and Surge Alloy into Quantum Alloy. Requires power. Glows when active.
size: 3
hasPower: true
hasItems: true
craftTime: 60

# Base light settings for the block
emitLight: true
lightRadius: 60

consumes: {
  power: 2.0
  items: [
    thorium/1
    phase-fabric/1
    surge-alloy/1
  ]
}

requirements: [
surge-alloy/25
lead/25
thorium/25
phase-fabric/25
iron-ingot/25
]

outputItem: quantum-alloy/2

# This section controls the visual glow during crafting
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawDefault
    }
    {
      type: DrawFlame
      flameColor: 00c3ffff
    }
  ]
}

category: crafting
research: surge-smelter
conductivePower: true

shownPlanets: [serpulo , erekir , rospuleball]