type: GenericCrafter
name: T5 Quantum Smelter
description: Turns Thorium, Phase Fabric, and Surge Alloy into Quantum Alloy. Requires power. Glows when active.
size: 3
hasPower: true
hasItems: true
craftTime: 20

# Base light settings for the block
emitLight: true
lightRadius: 60

consumes: {
  power: 6.0
  items: [
    thorium/1
    phase-fabric/1
    surge-alloy/1
  ]
}

requirements: [
surge-alloy/300
lead/300
thorium/300
phase-fabric/300
m-iron-ingot/300
]

outputItem: quantum-alloy/6

# This section controls the visual glow during crafting
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawDefault
    }
    {
      type: DrawFlame
      flameColor: 00c3ffff
    }
  ]
}

category: crafting
research: qs-d
conductivePower: true
ambientSound: loopTech
ambientSoundVolume: 0.05
shownPlanets: [serpulo , erekir , rospuleball]