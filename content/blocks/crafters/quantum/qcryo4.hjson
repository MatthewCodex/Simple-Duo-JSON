# The base logic type for production blocks
type: GenericCrafter

# Visual name and description in the UI
name: T4 Quantum Cryofluid Mixer
description: Mixes cryofluid and titanium to produce quantum-cryofluid.

# Physical characteristics
size: 2
health: 700
category: crafting
research: qcryo3

# Base processing speed (in seconds per operation)
craftTime: 30.0

# Item and liquid storage limits inside the machine
itemCapacity: 50
liquidCapacity: 50.0

# Define what the block requires to run
consumes: {
  power: 4.0
  items: [
    titanium/1
  ]
  liquids: [
    cryofluid/0.5
  ]
}

# The single fluid output configuration
outputLiquid: quantum-cryofluid/5

# Build costs required to construct the block
requirements: [
  lead/150
  silicon/150
  titanium/150
  phase-fabric/150
  metaglass/150
]

drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: "-bottom"
    }
    {
      type: DrawLiquidTile
      drawLiquid: water
    }
    {
      type: DrawLiquidTile
      drawLiquid: cryofluid
      drawLiquidLight: true
    }
    {
      type: DrawDefault
    }
    
  ]
}

# Visual effect played when the machine finishes an item cycle
lightLiquid: cryofluid
conductivePower: true

shownPlanets: [serpulo , erekir , rospuleball]