type: GenericCrafter
name: T4 Quantum Smelter
description: Turns Thorium, Phase Fabric, and Surge Alloy into Quantum Alloy. Requires power. Glows when active.
size: 3
hasPower: true
hasItems: true
craftTime: 30

# Base light settings for the block
emitLight: true
lightRadius: 60

consumes: {
  power: 5.0
  items: [
    thorium/1
    phase-fabric/1
    surge-alloy/1
  ]
}

requirements: [
surge-alloy/150
lead/150
thorium/150
phase-fabric/150
m-iron-ingot/150
]

outputItem: quantum-alloy/5

# This section controls the visual glow during crafting
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawDefault
    }
    {
      type: DrawFlame
      flameColor: 00c3ffff
    }
  ]
}

category: crafting
research: qs-c
conductivePower: true
ambientSound: loopTech
ambientSoundVolume: 0.05
shownPlanets: [serpulo , erekir , rospuleball]