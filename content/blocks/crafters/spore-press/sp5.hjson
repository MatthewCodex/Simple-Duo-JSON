type: GenericCrafter
name: "T5 Spore Press"
description: "Squeezes spore pods using heavy mechanical pistons to extract oil."
size: 2
health: 560
craftTime: 12
hasPower: true
hasItems: true
hasLiquids: true

liquidCapacity: 250

// Consume Spore Pods and Power
consumes: {
  power: 2.0
  items: [
    spore-pod/1
  ]
}

// Output Oil
outputLiquid: oil/24.0

// Piston Visual Setup
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: "-bottom"
    }
    {
      type: DrawPistons
      sinMag: 1
    }
    {
      type: DrawDefault
    }
    {
      type: DrawLiquidRegion
      drawLiquid: oil
    }
    {
      type: DrawRegion
      suffix: "-top"
    }
  ]
}

requirements: [
  copper/250
  lead/250
  silicon/250
]
category: crafting
research: sp4
conductivePower: true

shownPlanets: [serpulo , erekir , rospuleball]