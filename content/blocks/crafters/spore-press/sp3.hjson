type: GenericCrafter
name: "T3 Spore Press"
description: "Squeezes spore pods using heavy mechanical pistons to extract oil."
size: 2
health: 400
craftTime: 16
hasPower: true
hasItems: true
hasLiquids: true

liquidCapacity: 150

// Consume Spore Pods and Power
consumes: {
  power: 1.6
  items: [
    spore-pod/1
  ]
}

// Output Oil
outputLiquid: oil/20.0

// Piston Visual Setup
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: "-bottom"
    }
    {
      type: DrawPistons
      sinMag: 1
    }
    {
      type: DrawDefault
    }
    {
      type: DrawLiquidRegion
      drawLiquid: oil
    }
    {
      type: DrawRegion
      suffix: "-top"
    }
  ]
}

requirements: [
  copper/50
  lead/50
  silicon/50
]
category: crafting
research: sp2
conductivePower: true

shownPlanets: [serpulo , erekir , rospuleball]