type: GenericCrafter
name: "T2 Spore Press"
description: "Squeezes spore pods using heavy mechanical pistons to extract oil."
size: 2
health: 320
craftTime: 18
hasPower: true
hasItems: true
hasLiquids: true

liquidCapacity: 100

// Consume Spore Pods and Power
consumes: {
  power: 1.4
  items: [
    spore-pod/1
  ]
}

// Output Oil
outputLiquid: oil/18.0

// Piston Visual Setup
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: "-bottom"
    }
    {
      type: DrawPistons
      sinMag: 1
    }
    {
      type: DrawDefault
    }
    {
      type: DrawLiquidRegion
      drawLiquid: oil
    }
    {
      type: DrawRegion
      suffix: "-top"
    }
  ]
}

requirements: [
  copper/25
  lead/25
  silicon/25
]
category: crafting
research: sp1
conductivePower: true

shownPlanets: [serpulo , erekir , rospuleball]