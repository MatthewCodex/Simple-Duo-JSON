type: GenericCrafter
name: "T4 Spore Press"
description: "Squeezes spore pods using heavy mechanical pistons to extract oil."
size: 2
health: 480
craftTime: 14
hasPower: true
hasItems: true
hasLiquids: true

liquidCapacity: 200

// Consume Spore Pods and Power
consumes: {
  power: 1.8
  items: [
    spore-pod/1
  ]
}

// Output Oil
outputLiquid: oil/22.0

// Piston Visual Setup
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: "-bottom"
    }
    {
      type: DrawPistons
      sinMag: 1
    }
    {
      type: DrawDefault
    }
    {
      type: DrawLiquidRegion
      drawLiquid: oil
    }
    {
      type: DrawRegion
      suffix: "-top"
    }
  ]
}

requirements: [
  copper/100
  lead/100
  silicon/100
]
category: crafting
research: sp3
