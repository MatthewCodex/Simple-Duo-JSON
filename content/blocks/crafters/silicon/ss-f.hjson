type: AttributeCrafter
name: T1 Silicon Crucible
description: Turns sand, coal, and pyratite into silicon. Glows when active and requires power. More efficient in hot locations.
size: 3
hasItems: true
craftTime: 60

# Base light settings for the block
emitLight: true
lightRadius: 60

consumes: {
  power: 0.5
  items: [
    coal/2
    sand/2
    pyratite/2
  ]
}

attribute: heat

baseEfficiency: 1.0
boostScale: 0.2

requirements: [
titanium/50
metaglass/50
plastanium/50
silicon/50
]

outputItem: silicon/4

# This section controls the visual glow during crafting
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawDefault
    }
    {
      type: DrawFlame
      flameColor: ffef99ff
    }
  ]
}

category: crafting
research: silicon-crucible
conductivePower: true

shownPlanets: [serpulo , erekir , rospuleball]