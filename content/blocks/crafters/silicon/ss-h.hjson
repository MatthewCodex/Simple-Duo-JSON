type: AttributeCrafter
name: T3 Silicon Crucible
description: Turns sand, coal, and pyratite into silicon. Glows when active and requires power. More efficient in hot locations.
size: 3
hasItems: true
craftTime: 50

# Base light settings for the block
emitLight: true
lightRadius: 60

consumes: {
  power: 1.5
  items: [
    coal/2
    sand/2
    pyratite/2
  ]
}

attribute: heat

baseEfficiency: 1.0
boostScale: 0.6

requirements: [
titanium/100
metaglass/100
plastanium/100
silicon/100
]

outputItem: silicon/8

# This section controls the visual glow during crafting
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawDefault
    }
    {
      type: DrawFlame
      flameColor: ffef99ff
    }
  ]
}

category: crafting
research: ss-g
conductivePower: true

shownPlanets: [serpulo , erekir , rospuleball]