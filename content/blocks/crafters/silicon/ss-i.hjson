type: AttributeCrafter
name: T4 Silicon Crucible
description: Turns sand, coal, and pyratite into silicon. Glows when active and requires power. More efficient in hot locations.
size: 3
hasItems: true
craftTime: 45

# Base light settings for the block
emitLight: true
lightRadius: 60

consumes: {
  power: 2.0
  items: [
    coal/2
    sand/2
    pyratite/2
  ]
}

attribute: heat

baseEfficiency: 1.0
boostScale: 0.8

requirements: [
titanium/125
metaglass/125
plastanium/125
silicon/125
]

outputItem: silicon/10

# This section controls the visual glow during crafting
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawDefault
    }
    {
      type: DrawFlame
      flameColor: ffef99ff
    }
  ]
}

category: crafting
research: ss-h
conductivePower: true

shownPlanets: [serpulo , erekir , rospuleball]