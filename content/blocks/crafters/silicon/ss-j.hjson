type: AttributeCrafter
name: T4 Silicon Crucible
description: Turns sand, coal, and pyratite into silicon. Glows when active and requires power. More efficient in hot locations.
size: 3
hasItems: true
craftTime: 40

# Base light settings for the block
emitLight: true
lightRadius: 60

consumes: {
  power: 2.5
  items: [
    coal/2
    sand/2
    pyratite/2
  ]
}

attribute: heat

baseEfficiency: 1.0
boostScale: 1.0

requirements: [
titanium/150
metaglass/150
plastanium/150
silicon/150
]

outputItem: silicon/12

# This section controls the visual glow during crafting
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawDefault
    }
    {
      type: DrawFlame
      flameColor: ffef99ff
    }
  ]
}

category: crafting
research: ss-i
conductivePower: true

shownPlanets: [serpulo , erekir , rospuleball]