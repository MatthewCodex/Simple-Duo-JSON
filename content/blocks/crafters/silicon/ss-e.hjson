type: GenericCrafter
name: T5 Silicon Smelter
description: Turns sand and coal into silicon. Glows when active.
size: 2
hasItems: true
craftTime: 10

# Base light settings for the block
emitLight: true
lightRadius: 60

consumes: {
  items: [
    coal/1
    sand/1
  ]
}

requirements: [
silicon/400
copper/400
lead/400
]

outputItem: silicon/6

# This section controls the visual glow during crafting
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawDefault
    }
    {
      type: DrawFlame
      flameColor: ffef99ff
    }
  ]
}

category: crafting
research: ss-d