type: AttributeCrafter
name: T2 Silicon Crucible
description: Turns sand, coal, and pyratite into silicon. Glows when active and requires power. More efficient in hot locations.
size: 3
hasItems: true
craftTime: 55

# Base light settings for the block
emitLight: true
lightRadius: 60

consumes: {
  power: 1.0
  items: [
    coal/2
    sand/2
    pyratite/2
  ]
}

attribute: heat

baseEfficiency: 1.0
boostScale: 0.4

requirements: [
titanium/75
metaglass/75
plastanium/75
silicon/75
]

outputItem: silicon/6

# This section controls the visual glow during crafting
drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawDefault
    }
    {
      type: DrawFlame
      flameColor: ffef99ff
    }
  ]
}

category: crafting
research: ss-f
conductivePower: true

shownPlanets: [serpulo , erekir , rospuleball]