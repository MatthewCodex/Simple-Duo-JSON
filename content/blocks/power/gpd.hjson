type: AttributeCrafter
name: "Geothermal Power Dynamo"
description: "Generates power by drawing energy from high-attribute environmental tiles."
size: 3
category: power
hasPower: true
hasItems: false
hasLiquids: false

# This makes the block act as a power provider.
# A negative powerUse means it constantly provides power to the grid.
consume: {
  power: -10.0
}

# The block scales efficiency based on the "heat" attribute of tiles underneath it.
attribute: heat
baseEfficiency: 0.0
boostScale: 1.0
maxBoost: 5.0
minEfficiency: 0.1

# Ensure it connects to and transmits power
outputsPower: true
consumesPower: false
