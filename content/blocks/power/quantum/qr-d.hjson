type: NuclearReactor
name: T4 Quantum Reactor
description: Produces power by consuming quantum alloy. Detonates more violently than a thorium reactor if it overheats or loses quantum cryofluid.
size: 3
health: 3000

// Item and Liquid Inputs
hasItems: true
hasLiquids: true
itemCapacity: 100
liquidCapacity: 100
hasPower: true

// Power Generation
powerProduction: 70

// Heating Mechanics
heating: 0.02
coolantPower: 0.5

// Explosion Properties
explosionRadius: 80
explosionDamage: 12000

consumes: {
  items: [
    quantum-alloy/1
  ]
  liquid: {
    liquid: quantum-cryofluid
    amount: 0.25
  }
}

requirements: [
  lead/200
  silicon/200
  thorium/200
  phase-fabric/200
  quantum-alloy/200
]

category: power
research: qr-c
  conductivePower: true
