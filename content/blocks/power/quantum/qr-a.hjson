type: NuclearReactor
name: T1 Quantum Reactor
description: Produces power by consuming quantum alloy. Detonates more violently than a thorium reactor if it overheats or loses quantum cryofluid.
size: 3
health: 1500

// Item and Liquid Inputs
hasItems: true
hasLiquids: true
itemCapacity: 100
liquidCapacity: 100
hasPower: true

// Power Generation
powerProduction: 40

// Heating Mechanics
heating: 0.02
coolantPower: 0.5

// Explosion Properties
explosionRadius: 80
explosionDamage: 12000

consumes: {
  items: [
    quantum-alloy/1
  ]
  liquid: {
    liquid: quantum-cryofluid
    amount: 0.25
  }
}

requirements: [
  lead/10
  silicon/10
  thorium/10
  phase-fabric/10
  quantum-alloy/10
]

category: power
research: thorium-reactor
  conductivePower: true
