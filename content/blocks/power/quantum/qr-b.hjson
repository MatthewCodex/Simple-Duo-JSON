type: NuclearReactor
name: T2 Quantum Reactor
description: Produces power by consuming quantum alloy. Detonates more violently than a thorium reactor if it overheats or loses quantum cryofluid.
size: 3
health: 2000

// Item and Liquid Inputs
hasItems: true
hasLiquids: true
itemCapacity: 100
liquidCapacity: 100
hasPower: true

// Power Generation
powerProduction: 50

// Heating Mechanics
heating: 0.02
coolantPower: 0.5

// Explosion Properties
explosionRadius: 80
explosionDamage: 12000

consumes: {
  items: [
    quantum-alloy/1
  ]
  liquid: {
    liquid: quantum-cryofluid
    amount: 0.25
  }
}

requirements: [
  lead/25
  silicon/25
  thorium/25
  phase-fabric/25
  quantum-alloy/25
]

category: power
research: qr-a
  conductivePower: true
