type: ConsumeGenerator
name: "T4 RTG Generator"
description: Consumes radioactive items to produce power.
size: 2
health: 900
category: power
research: rtg3

# Power Generation Settings
powerProduction: 8

# Fuel Consumption Settings
itemDuration: 120.0
consumes: {
  itemRadioactive: {}
}
itemDurationMultipliers: {
  
  phase-fabric: 2.0
  
}



# Visuals and Effects
requirements: [
  silicon/150
  lead/150
  phase-fabric/150
  plastanium/150
  thorium/150
]

drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawDefault
    }
    {
      type: DrawWarmupRegion
      // The suffix appended to your block's name for the texture
      suffix: -top
      // The color the texture blends into as it heats up
      color: bf92f9
    }
    
  ]
}

ambientSound: generatespark
ambientSoundVolume: 0.1
conductivePower: true

shownPlanets: [serpulo , erekir , rospuleball]