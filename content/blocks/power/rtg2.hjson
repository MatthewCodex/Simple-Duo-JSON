type: ConsumeGenerator
name: "T2 RTG Generator"
description: Consumes radioactive items to produce power.
size: 2
health: 700
category: power
research: rtg1

# Power Generation Settings
powerProduction: 5.5

# Fuel Consumption Settings
itemDuration: 120.0
consumes: {
  itemRadioactive: {}
}
itemDurationMultipliers: {
  
  phase-fabric: 2.0
  
}



# Visuals and Effects
requirements: [
  silicon/25
  lead/25
  phase-fabric/25
  plastanium/25
  thorium/25
]

drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawDefault
    }
    {
      type: DrawWarmupRegion
      // The suffix appended to your block's name for the texture
      suffix: -top
      // The color the texture blends into as it heats up
      color: bf92f9
    }
    
  ]
}

ambientSound: generatespark
ambientSoundVolume: 0.1
