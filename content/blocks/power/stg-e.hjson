type: ConsumeGenerator
name: "T5 Steam Generator"
description: Uses water and flammable items to produce power.
size: 2
health: 700
category: power
research: stg-d
hasLiquids: true

# Power Generation Settings
powerProduction: 8.0

# Fuel Consumption Settings
itemDuration: 120.0
consumes: {
  itemFlammable: {}
  itemExplode: {}
  liquids: [
      water/0.5
    ]
}

# Visuals and Effects
requirements: [
  copper/200
  lead/200
  graphite/200
  metaglass/200
]

drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawDefault
    }
    {
      type: DrawWarmupRegion
      // The suffix appended to your block's name for the texture
      suffix: -top
      // The color the texture blends into as it heats up
      color: ff7a00
    }
    {
      type: DrawRegion
      // Name of your sub-sprite (looks for your-block-name-spinner.png)
      suffix: "-turbine"
      spinSprite: true
      rotateSpeed: 2
    }
    {
      type: DrawRegion
      // Name of your sub-sprite (looks for your-block-name-spinner.png)
      suffix: "-turbine"
      spinSprite: true
      rotateSpeed: -2
      rotation: 45
    }
    {
      type: DrawRegion
      // Name of your sub-sprite (looks for your-block-name-cap.png)
      suffix: "-cap"
    }
    {
      type: DrawLiquidRegion
      // Specify your custom sprite suffix here (include the leading hyphen)
      suffix: "-liquid"
      drawLiquid: water
    }
  ]
}


ambientSound: generatespark
ambientSoundVolume: 0.2
