type: PowerTurret
name: Basic Pierce Turret
description: Shoots piercing projectiles.
hasPower: true
size: 1
health: 800
range: 100
reload: 60
category: turret

# Configure power requirements
consumes: {
  power: 1
}

# Define the laser properties
shootType: {
  type: ContinuousLaserBulletType
  damage: 100
  length: 200
  width: 4
  incendAmount: 0
  incendSpread: 0
  incendChance: 0
  # Visual colors of the laser beam (Ice blue themes)
  colors: [008080, 00bfbf, 00ffff]

  pierce: true
  pierceCap: 3  
  
  # Optional cosmetic effects
  hitEffect: none
  smokeEffect: none
}

requirements: [
  copper/100
  lead/100
  silicon/100
  titanium/100
]
research: arc

drawer: {
  type: DrawTurret
  basePrefix: "turret-"
}

shownPlanets: [serpulo , erekir , rospuleball]