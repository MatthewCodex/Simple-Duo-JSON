  power: 3
}

# Define the laser properties
shootType: {
  type: ContinuousLaserBulletType
  damage: 150
  length: 300
  width: 4
  incendAmount: 0
  incendSpread: 0
  incendChance: 0
  # Visual colors of the laser beam (Ice blue themes)
  colors: [008080, 00bfbf, 00ffff]

  pierce: true
  pierceCap: 5  
  
  # Optional cosmetic effects
  hitEffect: none
  smokeEffect: none
}

requirements: [
  copper/100
  lead/100
  silicon/100
  titanium/100
  metaglass/100
  m-iron-ingot/100
]
research: turret-jb

drawer: {
  type: DrawTurret
  basePrefix: "turret-"
}

