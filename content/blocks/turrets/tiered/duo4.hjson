type: ItemTurret
name: T4 Duo
description: Fires alternating left and right barrels with visual recoil.
size: 1
health: 300
range: 175
reload: 7
recoil: 0.5 // Global recoil distance
researchCostMultiplier: 0.5
ammoUseEffect: casing1
recoils: 2
requirements: [
copper/100
]

// Crucial: Tells the turret to alternate which barrel fires first/second
shoot: {
  type: ShootAlternate
  barrels: 2
  spread: 6 // Total width spacing between the two barrels
}

ammoTypes: {
  copper: {
    speed: 4
    damage: 16
    width: 7
    height: 7
    ammoMultiplier: 2
    hitEffect: hitBulletColor
    despawnEffect: hitBulletColor
    hitColor: copperAmmoBack
    backColor: copperAmmoBack
    trailColor: copperAmmoBack
    frontColor: copperAmmoFront
  }
  graphite: {
    speed: 4
    damage: 24
    width: 7
    height: 7
    ammoMultiplier: 4
    hitEffect: hitBulletColor
    despawnEffect: hitBulletColor
    hitColor: graphiteAmmoBack
    backColor: graphiteAmmoBack
    trailColor: graphiteAmmoBack
    frontColor: graphiteAmmoFront
  }
}

drawer: {
  type: DrawTurret
  
  parts: [
   {
    type: RegionPart
    suffix: -l
    progress: recoil
    recoilIndex: 0     // Links to the first shot (left)
    moveY: -1.5          // How far back the barrel moves when firing
    under: true        // Renders underneath the main turret base
  }
  {
    type: RegionPart
    suffix: -r
    progress: recoil
    recoilIndex: 1     // Links to the second shot (right)
    moveY: -1.5          // How far back the barrel moves when firing
    under: true        // Renders underneath the main turret base
  }
  ]
}

category: turret
research: duo3
shownPlanets: [serpulo , rospuleball]