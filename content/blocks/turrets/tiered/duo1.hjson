type: ItemTurret
name: T1 Duo
description: Fires alternating left and right barrels with visual recoil.
size: 1
health: 300
range: 150
reload: 10
recoil: 0 // Global recoil distance
researchCostMultiplier: 0.5

requirements: [
copper/50
]

// Crucial: Tells the turret to alternate which barrel fires first/second
shoot: {
  type: ShootAlternate
  barrels: 2
  spread: 6 // Total width spacing between the two barrels
}

ammoTypes: {
  copper: {
    speed: 4
    damage: 10
    width: 7
    height: 7
  }
}

drawer: {
  type: DrawTurret
  
  parts: [
    {
    type: RegionPart
    name: duo1-l
    under: true
    // This barrel recoils on the first shot of the 2-shot cycle
    progress: {
      type: recoil
      index: 0
    }
    // How far back the barrel moves (in pixels)
    moveY: -3
  }
  {
    type: RegionPart
    name: duo1-r
    under: true
    // This barrel recoils on the second shot of the 2-shot cycle
    progress: {
      type: recoil
      index: 1
    }
    // How far back the barrel moves (in pixels)
    moveY: -3
  }
  ]
}

category: turret
research: core-shard
shownPlanets: [serpulo , rospuleball]