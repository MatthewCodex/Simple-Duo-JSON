type: Reconstructor
name: "Reconstructor 1"
description: "Upgrades Basic Units to Advanced Units."
size: 5
health: 1200
itemCapacity: 120
constructTime: 120
# Upgrades require power and resources to operate
requirements: [
  copper/100
  silicon/100
  lead/100
  graphite/100
  metaglass/100
]
consumes: {
  power: 1.5
  items: {
    items: [
      copper/50
      silicon/50
    ]
  }
}
# Define what tier binds to what tier
upgrades: [
  [
    tank-aa
    tank-ab
  ]
  [
    tank-ba
    tank-bb
  ]
]
category: units
research: additive-reconstructor
